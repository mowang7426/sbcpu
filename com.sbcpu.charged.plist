<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sbcpu.charged</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/libexec/SBCPUChargeDaemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<!-- 崩溃/异常退出自动拉起；SIGTERM 正常退出不重复拉起。 -->
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/var/jb/var/log/sbcpu_charge.log</string>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/log/sbcpu_charge.log</string>
</dict>
</plist>
