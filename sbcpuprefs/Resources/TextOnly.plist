<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>纯文字浮窗</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>纯文字浮窗</string>
			<key>footerText</key>
			<string>默认关闭。仅隐藏浮窗背景与装饰，保留实时监测文字。开启时不避让灵动岛，顶部文字可能被硬件遮挡；状态栏吸附、自动折叠及键盘避让临时不生效，普通配置不变。关闭后恢复普通外观与位置。</string>
		</dict>
		<dict>
			<key>defaults</key>
			<string>com.yourname.sbcpufloating</string>
			<key>get</key>
			<string>getPreferenceValue:</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用纯文字浮窗</string>
			<key>key</key>
			<string>floatingTextOnlyMode</string>
			<key>default</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>字号</string>
			<key>footerText</key>
			<string>独立字号 8–24 pt，不改变普通浮窗字号或缩放。</string>
		</dict>
		<dict>
			<key>defaults</key>
			<string>com.yourname.sbcpufloating</string>
			<key>get</key>
			<string>getPreferenceValue:</string>
			<key>set</key>
			<string>setPreferenceValue:specifier:</string>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>文字大小</string>
			<key>key</key>
			<string>floatingTextOnlyFontSize</string>
			<key>default</key>
			<integer>13</integer>
			<key>min</key>
			<integer>8</integer>
			<key>max</key>
			<integer>24</integer>
			<key>showValue</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>顶部预设</string>
			<key>footerText</key>
			<string>选择预设会清零 X/Y 偏移。顶部居中不是屏幕中央；本模式不避让灵动岛。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>左上角</string>
			<key>action</key>
			<string>topLeft</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>顶部居中</string>
			<key>action</key>
			<string>topCenter</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>右上角</string>
			<key>action</key>
			<string>topRight</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>位置微调</string>
			<key>footerText</key>
			<string>每次移动 8 pt，可拖动浮窗；X 正数向右，Y 正数向下。数值相对所选预设，最终位置限制在屏幕边缘。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>↑ 向上 8 pt</string>
			<key>action</key>
			<string>moveUp</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>↓ 向下 8 pt</string>
			<key>action</key>
			<string>moveDown</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>← 向左 8 pt</string>
			<key>action</key>
			<string>moveLeft</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>→ 向右 8 pt</string>
			<key>action</key>
			<string>moveRight</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>编辑水平偏移 X</string>
			<key>action</key>
			<string>editX</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>编辑垂直偏移 Y</string>
			<key>action</key>
			<string>editY</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>文字颜色</string>
			<key>footerText</key>
			<string>差值合成使用白色文字作为源，理论上白底黑字、黑底白字，不截图、不增加采样计时器。iOS 跨窗口合成效果尚待真机验证，不保证自动反色；若无效请手动选择固定黑字或白字。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>差值反色（实验性，需真机验证）</string>
			<key>action</key>
			<string>difference</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>固定白字（深色背景）</string>
			<key>action</key>
			<string>whiteText</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>固定黑字（浅色背景）</string>
			<key>action</key>
			<string>blackText</string>
		</dict>
	</array>
</dict>
</plist>
