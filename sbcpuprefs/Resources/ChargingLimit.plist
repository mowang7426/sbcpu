<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>达到上限时的行为</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>保留外部电源</string><key>key</key><string>chargeKeepAC</string><key>default</key><true/><key>get</key><string>getPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string><key>footerText</key><string>开启：只停止充电并保留外部供电；关闭：同时阻断外部供电。</string></dict>
